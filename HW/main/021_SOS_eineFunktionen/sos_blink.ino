sos_blink() {
  //S
  digitalWrite(D13, HIGH);
  delay(250);
  digitalWrite(D13, LOW);
  delay(250);
  digitalWrite(D13, HIGH);
  delay(250);
  digitalWrite(D13, LOW);
  delay(250);
  digitalWrite(D13, HIGH);
  delay(250);
  digitalWrite(D13, LOW);
  delay(500);

  //O
  digitalWrite(D13, HIGH);
  delay(1000);
  digitalWrite(D13, LOW);
  delay(250);
  digitalWrite(D13, HIGH);
  delay(1000);
  digitalWrite(D13, LOW);
  delay(250);
  digitalWrite(D13, HIGH);
  delay(1000);
  digitalWrite(D13, LOW);
  delay(500);

  //S
  digitalWrite(D13, HIGH);
  delay(250);
  digitalWrite(D13, LOW);
  delay(250);
  digitalWrite(D13, HIGH);
  delay(250);
  digitalWrite(D13, LOW);
  delay(250);
  digitalWrite(D13, HIGH);
  delay(250);
  digitalWrite(D13, LOW);
  delay(1000);
}